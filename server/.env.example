# Server Configuration
PORT=3000
CORS_ORIGIN=http://localhost:5500

# Gemini AI Configuration
# Use GEMINI_API_KEY for Bearer tokens (recommended for production)
# Use LEGACY_GEMINI_KEY for older API keys passed as URL parameter
GEMINI_API_KEY=
LEGACY_GEMINI_KEY=

# Gemini Model (recommended: gemini-2.0-flash or gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Require Gemini at startup (1 = fail if no key, 0 = optional)
REQUIRE_GEMINI=0

# Serper API Key (for web search functionality)
SERPER_API_KEY=

# Admin Password (for protected admin endpoints)
ADMIN_PASSWORD=

# Google Secret Manager (optional - for production key management)
# Example: projects/PROJECT_ID/secrets/SECRET_NAME/versions/latest
SECRET_MANAGER_NAME=
